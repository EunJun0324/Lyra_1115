# Visual Studio 2015 user specific files
LyraStarterGame/.vs/

# Compiled Object files
LyraStarterGame/*.slo
LyraStarterGame/*.lo
LyraStarterGame/*.o
LyraStarterGame/*.obj

# Precompiled Headers
LyraStarterGame/*.gch
LyraStarterGame/*.pch

# Compiled Dynamic libraries
LyraStarterGame/*.so
LyraStarterGame/*.dylib
LyraStarterGame/*.dll

# Fortran module files
LyraStarterGame/*.mod

# Compiled Static libraries
LyraStarterGame/*.lai
LyraStarterGame/*.la
LyraStarterGame/*.a
LyraStarterGame/*.lib

# Executables
LyraStarterGame/*.exe
LyraStarterGame/*.out
LyraStarterGame/*.app
LyraStarterGame/*.ipa

# These project files can be generated by the engine
LyraStarterGame/*.xcodeproj
LyraStarterGame/*.xcworkspace
LyraStarterGame/*.sln
LyraStarterGame/*.suo
LyraStarterGame/*.opensdf
LyraStarterGame/*.sdf
LyraStarterGame/*.VC.db
LyraStarterGame/*.VC.opendb
LyraStarterGame/.vsconfig

# Precompiled Assets
LyraStarterGame/SourceArt/**/*.png
LyraStarterGame/SourceArt/**/*.tga

# Binary Files
LyraStarterGame/Binaries/*
LyraStarterGame/Plugins/**/Binaries/*

# Builds
LyraStarterGame/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!LyraStarterGame/Build/*/
LyraStarterGame/Build/*/**
!LyraStarterGame/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!LyraStarterGame/Build/**/*.ico

# Built data for maps
LyraStarterGame/*_BuiltData.uasset

# Configuration files generated by the Editor
LyraStarterGame/Saved/*

# Compiled source files for the engine to use
LyraStarterGame/Intermediate/*
LyraStarterGame/Plugins/**/Intermediate/*

# Cache files for the editor to use
LyraStarterGame/DerivedDataCache/*
LyraStarterGame/Plugins/LyraExampleContent

#Custom
LyraStarterGame/Source/*
LyraStarterGame/Content/*
LyraStarterGame/Docs/*
!LyraStarterGame/Content/Custom/
!LyraStarterGame/Content/Custom/
LyraStarterGame/Plugins/*
